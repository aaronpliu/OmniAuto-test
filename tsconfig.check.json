{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["src/contracts/*"],
      "@adapters/*": ["src/adapters/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "reports"]
}
