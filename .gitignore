# Dependencies
node_modules/
.pnp/
.pnp.js

# Husky internal (hook runner)
.husky/_/

# Build / compile output
dist/
build/
*.tsbuildinfo

# Test reports & artifacts
reports/
artifacts/
coverage/
*.log

# Detox native build output
ios/build/
android/app/build/
android/build/

# Prebuilt app binaries under apps/**/artifacts/{ios,android}
# Keep the folders (via .gitkeep) but never commit the built app/APK.
# Only the binaries are ignored; .gitkeep stays tracked so the dirs are kept.
apps/**/artifacts/ios/*.app/
apps/**/artifacts/ios/*.app
apps/**/artifacts/android/*.apk
apps/**/artifacts/android/*.aab

# Screenshots captured during tests
*.png
*.jpg

# Environment / secrets
# `.env` holds only shared/global values. Per-app settings are NOT kept in env
# files — they are derived from E2E_APP or loaded from committed
# configs/<app>.config.json. Ignore every local .env variant so none are ever
# committed; `.env.example` stays tracked as the schema reference.
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
