# ─────────────── 依赖 ───────────────
node_modules/

# ─────────────── 环境变量（含凭据，绝不入库） ───────────────
.env
.env.local
.env.*.local

# ─────────────── 运行期产物 ───────────────
# 运行时临时目录：run-config.json / shards/*.json
reports/.run/
# 报告产物（JUnit XML / JSON / HTML），按需在 CI 中单独归档
reports/*.xml
reports/*.json
reports/*.html
# 截图与视频只保留占位符，实际产物不入库
reports/screenshots/*
!reports/screenshots/.gitkeep
reports/videos/*
!reports/videos/.gitkeep

# ─────────────── 日志 ───────────────
*.log
npm-debug.log*
yarn-error.log*

# ─────────────── 各框架的本地产物 ───────────────
# Detox
artifacts/
# XCUITest / Xcode
DerivedData/
*.xcresult
*.xctestrun

# ─────────────── 编译与缓存 ───────────────
dist/
build/
*.tsbuildinfo
.cache/
coverage/

# ─────────────── 临时校验脚本 ───────────────
__verify_*.ts

# ─────────────── Jest 缓存 ───────────────
reports/.jest-cache/

# ─────────────── 编辑器 / 系统 ───────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# ─────────────── reports/ ───────────────
reports/*
!reports/screenshots/.gitkeep
!reports/videos/.gitkeep
