{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@tests/*": ["tests/*"],
      "@configs/*": ["configs/*"],
      "@omnitest/core/*": ["core/*"],
      "@omnitest/plugins/*": ["plugins/*"]
    },
    "typeRoots": ["./node_modules/@types", "./core/types"]
  },
  "include": [
    "core/**/*",
    "plugins/**/*",
    "platform-api/**/*",
    "tests/**/*",
    "examples/**/*",
    "configs/**/*"
  ],
  "exclude": ["node_modules", "dist", "artifacts"]
}
