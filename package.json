{
  "name": "appauto",
  "version": "1.0.0",
  "description": "Cross-platform test automation framework for React Native iOS (Detox), Android (Appium), Web (Playwright), and API testing",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prepare": "husky",
    "build": "tsc",
    "test:smoke:ios": "TEST_PLATFORM=ios detox test --configuration ios.sim.debug --config configs/jest/ios.detox.config.js",
    "report:smoke": "ts-node framework/reporters/smokeHtmlGenerator.ts",
    "test:mobile:ios": "TEST_PLATFORM=ios detox test --configuration ios.sim.debug",
    "test:mobile:ios:appium": "NODE_OPTIONS=--experimental-vm-modules TEST_PLATFORM=ios IOS_AUTOMATION_MODE=appium jest --config configs/jest/ios.appium.config.js",
    "test:mobile:android": "NODE_OPTIONS=--experimental-vm-modules TEST_PLATFORM=android jest --config configs/jest/android.appium.config.js",
    "test:mobile:android:detox": "TEST_PLATFORM=android ANDROID_AUTOMATION_MODE=detox detox test --configuration android.emu.debug --config configs/jest/android.detox.config.js",
    "test:mobile": "npm run test:mobile:ios && npm run test:mobile:android",
    "test:web": "playwright test --config configs/playwright.config.ts",
    "test:web:chromium": "playwright test --config configs/playwright.config.ts --project=chromium --headed",
    "test:web:firefox": "playwright test --config configs/playwright.config.ts --project=firefox",
    "test:web:webkit": "playwright test --config configs/playwright.config.ts --project=webkit",
    "test:api": "jest tests/api --config configs/jest/api.config.js",
    "test:all": "npm run test:mobile && npm run test:web && npm run test:api",
    "report:generate": "allure generate artifacts/allure-results --clean -o artifacts/allure-report",
    "report:open": "allure open artifacts/allure-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "clean": "rm -rf dist artifacts"
  },
  "keywords": [
    "testing",
    "automation",
    "detox",
    "appium",
    "playwright",
    "react-native",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "allure-commandline": "^2.25.0",
    "allure-jest": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^7.6.2",
    "appium-xcuitest-driver": "^11.14.0",
    "axios": "^1.6.2",
    "detox": "^20.51.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "playwright": "^1.40.0",
    "prettier": "^3.1.0",
    "sharp": "^0.33.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "webdriverio": "^8.27.0",
    "winston": "^3.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
