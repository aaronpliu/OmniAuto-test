# ═══════════════════════════════════════════════════════════════════════════
# OmniAutoTest E2E —— 环境变量样例
#
# 用法：cp .env.example .env  然后按本机情况修改。
#
# ⚠ 强约束（US-12 / T02 会写反向校验）：
#   本文件的 KEY 集合必须与 src/configs/env.config.ts 的 ENV_SPEC 逐条一一对应，
#   多一条或少一条都会导致 dry-run 的 env-spec 检查项失败。
#   新增变量时：先加 ENV_SPEC 条目，再同步本文件，二者顺序与分组保持一致。
#
# 说明：留空值表示「该项可选，不填则使用 ENV_SPEC 中的 defaultValue 或视为未设置」。
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────── 运行环境 ───────────────
# 运行环境标识，影响日志格式默认值与部分超时策略。取值：local | ci | staging | prod
OMNI_NODE_ENV=local

# 被测服务端基础地址（仅需要与后端交互的用例使用；纯 UI 冒烟可留空）
OMNI_BASE_URL=

# ─────────────── Appium ───────────────
# Appium Server 地址。Appium 框架必需；其它框架忽略此项。
OMNI_APPIUM_SERVER_URL=http://127.0.0.1:4723

# ─────────────── 测试凭据 ───────────────
# 供 workflows/loginWorkflow.ts 使用，脚本层禁止硬编码账号密码。
OMNI_USERNAME=demo
OMNI_PASSWORD=demo123
# 双因子登录的 TOTP 种子（不需要时留空）
OMNI_OTP_SECRET=

# ─────────────── 超时（毫秒，正整数） ───────────────
# 兜底默认超时；优先级最低，会被 framework/app/CLI 层层覆盖
OMNI_TIMEOUT_DEFAULT_MS=30000
# 单个原子动作超时（tap / typeText / getText ...）
OMNI_TIMEOUT_ACTION_MS=15000
# 显式等待超时（waitForVisible / waitForText ...）
OMNI_TIMEOUT_WAIT_MS=20000
# 会话建立 / App 启动超时（Appium remote、Detox init、XCUITest Runner 握手）
OMNI_TIMEOUT_STARTUP_MS=120000

# ─────────────── 产物与日志 ───────────────
# 产物根目录，相对工程根（e2e/）。截图、视频、报告均落在其下。
OMNI_ARTIFACTS_DIR=reports
# 日志级别：debug | info | warn | error | silent
OMNI_LOG_LEVEL=info
# 日志格式：text（人读，默认） | json（CI 友好，便于日志系统结构化采集）
OMNI_LOG_FORMAT=text

# ─────────────── 平台工具链 ───────────────
# xcrun 可执行路径，XCUITest 框架使用；macOS 默认自带
OMNI_XCRUN_PATH=/usr/bin/xcrun
# Android SDK 根目录，Android 真机/模拟器使用；未设置时回退到系统同名变量
ANDROID_SDK_ROOT=

# ─────────────── 设备覆盖 ───────────────
# 指定 iOS 真机 udid 或 Android 真机 serial；留空则使用 configs/devices/* 的默认设备
OMNI_DEVICE_UDID=
