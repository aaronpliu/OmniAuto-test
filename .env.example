# ============================================
# Appium Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --------------------------------------------
# Appium Server Connection
# --------------------------------------------
# Appium server hostname (default: localhost)
APPIUM_HOST=localhost

# Appium server port (default: 4723)
# Use 4723 for single instance, or different ports for parallel sessions
APPIUM_PORT=4723

# Appium server path (default: /wd/hub)
# Most Appium servers use /wd/hub as the WebDriver endpoint
APPIUM_PATH=/wd/hub

# --------------------------------------------
# Android Configuration
# --------------------------------------------
# Android device name or emulator ID
# Examples: emulator-5554, device_serial_number
ANDROID_DEVICE_NAME=emulator-5554

# Android platform version
# Examples: 11, 12, 13, 14
ANDROID_PLATFORM_VERSION=13

# Android app package name
# Example: com.example.myapp
ANDROID_APP_PACKAGE=com.example.myapp

# Android app activity to launch
# Example: .MainActivity, com.example.myapp.MainActivity
ANDROID_APP_ACTIVITY=.MainActivity

# Path to Android APK file
# Can be absolute path or relative to project root
# Example: ./apps/android/app-debug.apk
ANDROID_APP_PATH=./apps/android/app-debug.apk

# Android automation engine
# Options: UiAutomator2 (recommended), Espresso, UiAutomator1
ANDROID_AUTOMATION_NAME=UiAutomator2

# Android system port (for ADB communication)
# Default: 8200
ANDROID_SYSTEM_PORT=8200

# Android ChromeDriver port (for webview testing)
# Default: auto-detect
# ANDROID_CHROMEDRIVER_PORT=9515

# --------------------------------------------
# iOS Configuration
# --------------------------------------------
# iOS device name or simulator name
# Examples: iPhone 14, iPhone 15 Pro Max, device_udid
IOS_DEVICE_NAME=iPhone 14

# iOS platform version
# Examples: 16.0, 17.0, 17.2
IOS_PLATFORM_VERSION=17.0

# iOS app bundle ID
# Example: com.example.myapp
IOS_BUNDLE_ID=com.example.myapp

# Path to iOS .app or .ipa file
# For simulators: .app directory
# For real devices: .ipa file
# Example: ./apps/ios/MyApp.app or ./apps/ios/MyApp.ipa
IOS_APP_PATH=./apps/ios/MyApp.app

# iOS automation engine
# Options: XCUITest (recommended), XCTest
IOS_AUTOMATION_NAME=XCUITest

# iOS simulator UDID (optional, auto-detected if not provided)
# Get UDID with: xcrun simctl list devices
# IOS_UDID=AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE

# iOS webkit debug proxy port (for Safari/webview testing)
# Default: 27753
# IOS_WEBKIT_DEBUG_PROXY_PORT=27753

# --------------------------------------------
# Common Capabilities
# --------------------------------------------
# Platform name (android or ios)
PLATFORM_NAME=android

# Test timeout in milliseconds (default: 60000)
NEW_COMMAND_TIMEOUT=60000

# Whether to reset app state between tests
# true: Clear app data, false: Keep app data
NO_RESET=false

# Whether to reinstall app before test
# true: Reinstall, false: Use existing installation
FULL_RESET=false

# Auto-grant permissions (Android)
# true: Auto-grant all permissions, false: Manual grant
AUTO_GRANT_PERMISSIONS=true

# Auto-accept alerts (iOS)
# true: Auto-accept system alerts, false: Manual handling
AUTO_ACCEPT_ALERTS=false

# Language setting for the app
# Example: en, es, fr, de, zh
LANGUAGE=en

# Locale setting for the app
# Example: US, ES, FR, DE, CN
LOCALE=US

# Orientation (PORTRAIT or LANDSCAPE)
ORIENTATION=PORTRAIT

# --------------------------------------------
# Advanced Settings
# --------------------------------------------
# Enable Appium server logs
# true: Enable detailed logging, false: Minimal logging
APPIUM_LOG_LEVEL=info

# Screenshot path for failed tests
SCREENSHOT_PATH=./artifacts/screenshots

# Video recording path (if supported)
VIDEO_PATH=./artifacts/videos

# Log path for test execution
LOG_PATH=./artifacts/logs

# Enable/disable network traffic logging
NETWORK_LOGGING=false

# Custom capabilities (JSON format)
# Add any additional capabilities as needed
# Example: {"appium:showXcodeLog": true}
CUSTOM_CAPABILITIES={}

# --------------------------------------------
# Parallel Testing (Optional)
# --------------------------------------------
# For running multiple Appium instances
# Set different ports for each instance

# Second Appium instance (optional)
APPIUM_HOST_2=localhost
APPIUM_PORT_2=4724

# Third Appium instance (optional)
APPIUM_HOST_3=localhost
APPIUM_PORT_3=4725

# --------------------------------------------
# Cloud Testing Services (Optional)
# --------------------------------------------
# Uncomment and configure if using cloud services

# BrowserStack
# BROWSERSTACK_USER=your_username
# BROWSERSTACK_KEY=your_access_key
# BROWSERSTACK_URL=https://hub-cloud.browserstack.com/wd/hub

# Sauce Labs
# SAUCELABS_USER=your_username
# SAUCELABS_KEY=your_access_key
# SAUCELABS_URL=https://ondemand.us-west-1.saucelabs.com:443/wd/hub

# LambdaTest
# LAMBDATEST_USER=your_username
# LAMBDATEST_KEY=your_access_key
# LAMBDATEST_URL=https://mobile-api.lambdatest.com/wd/hub

# --------------------------------------------
# Development vs Production
# --------------------------------------------
# Environment name (development, staging, production)
NODE_ENV=development

# API base URL for backend services
API_BASE_URL=https://api.dev.yourapp.com

# App base URL (if applicable)
APP_BASE_URL=https://dev.yourapp.com

# --------------------------------------------
# Test Credentials (Use secrets manager in production!)
# --------------------------------------------
# WARNING: Never commit real credentials to version control
# Use environment-specific secret management in production

# Test user credentials
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=password123

# Admin credentials (if needed)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=admin123

# --------------------------------------------
# Performance Settings
# --------------------------------------------
# Implicit wait timeout in milliseconds
IMPLICIT_WAIT=5000

# Page load timeout in milliseconds
PAGE_LOAD_TIMEOUT=30000

# Script timeout in milliseconds
SCRIPT_TIMEOUT=30000

# Element polling interval in milliseconds
ELEMENT_POLL_INTERVAL=500

# --------------------------------------------
# Docker Configuration (if using docker-compose)
# --------------------------------------------
# Docker Compose project name
COMPOSE_PROJECT_NAME=appauto

# Docker network name
DOCKER_NETWORK=appium-network

# Volume mount path for apps
APPS_VOLUME_PATH=./apps:/opt/apps
