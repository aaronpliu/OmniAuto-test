# ============================================================================
# OmniAutoTest — environment variables reference
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your local setup:
#     cp .env.example .env
#
# All variables are OPTIONAL unless marked [required]. If omitted, the framework
# falls back to the documented default (shown after each `=` below).
#
# Mechanisms that read these:
#   - Driver/app selection:  src/core/Driver.ts, .detoxrc.js, wdio.conf.ts, configs/env.ts
#   - Appium caps:           wdio.conf.ts
#   - Smoke reporter:        tests/smoke.e2e.ts
#   - Logging:               src/utils/logger.ts
#
# IMPORTANT — this file is for SHARED/global values only. DO NOT put app-specific
# values here (Android package/activity, app path, etc.). Those live in each
# framework's own config (detoxrc.js / wdio.conf.ts), keyed by E2E_APP. This keeps
# the shared .env from leaking app-specific values across concurrent multi-app runs.
# ============================================================================

# --- App selection ----------------------------------------------------------
# Which app's config + artifacts to load. Each framework dynamically loads its
# own config keyed by E2E_APP — no config edits needed to switch apps, just set
# E2E_APP (here, CI env, or CLI).
E2E_APP=mock

# --- Driver selection -------------------------------------------------------
# Which automation framework resolves the driver-agnostic contracts.
#   detox  : default; uses Detox (Jest runner, iOS/Android)
#   appium : uses WebdriverIO + Appium (Mocha runner, iOS/Android)
E2E_DRIVER=detox

# --- Detox runtime overrides (no .detoxrc.js edit needed) -------------------
# Select a configuration by name instead of retyping the long --configuration.
DETOX_CONFIG=
# Override the device alias (simulator | emulator | android.device).
DETOX_DEVICE=
# Override the device name/AVD/UDID inside the chosen device.
DETOX_DEVICE_NAME=
# Override the app binary path (iOS .app or Android .apk) — handy for local debug.
DETOX_BINARY_PATH=
# Override the Android instrumentation test APK path.
DETOX_TEST_BINARY_PATH=
# adb serial for a real attached Android device (used by android.device config).
DETOX_ANDROID_DEVICE=

# --- Appium / WebdriverIO (only used when E2E_DRIVER=appium) ----------------
# Target platform for the Appium capability set.
#   ios     : XCUITest  (default)
#   android : UiAutomator2
PLATFORM=ios

# Device / emulator name reported to the driver.
#   iOS default:     iPhone 15 Pro
#   Android default: Pixel_6_API_34
DEVICE_NAME=iPhone 15 Pro

# OS version of the target device/emulator.
#   iOS default:     17.0
#   Android default: 14.0
PLATFORM_VERSION=17.0

# (iOS only) Specific simulator UDID. Omit to let Appium pick the default.
UDID=

# (Android only) AVD name to launch when no device is connected.
AVD_NAME=Pixel_6_API_34

# --- App-specific values are NOT set here ------------------------------------
# App-specific settings live in each framework's own config, keyed by E2E_APP:
#   Detox  → configs/<E2E_APP>.detoxrc.js  (apps, devices, configurations)
#   Appium → wdio.conf.ts                   (Android appPackage/appActivity map)
# APPIUM_APP_PATH is derived from E2E_APP; override via the CLI env var below.
# (A CLI/shell env var still overrides the framework config for a one-off run.)

# --- Smoke reporter (tests/smoke.e2e.ts) ------------------------------------
# Directory where SmokeReporter writes JSON summaries. Defaults to an app-scoped
# folder (reports/<E2E_APP>/smoke) so concurrent runs of different apps don't
# overwrite each other. Set explicitly to override.
# The smoke scripts pass this via REPORT_DIR (e.g. npm run test:smoke:appium).
REPORT_DIR=

# --- Logging (src/utils/logger.ts) ------------------------------------------
# Console log level: trace | debug | info | warn | error
# Note: "trace" is mapped to winston's "debug" (most verbose).
LOG_LEVEL=info

# Session directory for file logging. Defaults to an app-scoped per-run folder
# (reports/<E2E_APP>/run-<ts>) so concurrent runs on one machine stay isolated.
# An explicit value (global setup / CI) still wins.
OMNITEST_SESSION_DIR=
